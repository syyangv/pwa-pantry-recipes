# Pantry Recipes PWA — runtime configuration template
#
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored;
# never commit secrets or absolute vault paths. Every variable is read by
# `app/config.py` at startup. The configuration is FAIL-CLOSED: an invalid or
# missing value for any variable marked "required" raises `ConfigurationError`
# and the process refuses to start. It never degrades silently.
#
# SERVER-OWNED: every value below comes from the process environment, never
# from an HTTP request. A browser cannot select a vault, a database path, a
# recipe root, or a daily-notes root — there is no request parameter, header,
# or body field that reaches these. That is deliberate: these paths decide what
# the app is allowed to read and write.
#
# *** THERE IS NO .env PARSER. *** `Settings.from_environment()` reads
# os.environ and nothing else. Copying this file to `.env` therefore records
# intent and configures NOTHING. Two real mechanisms, and only two:
#   * a shell:  `set -a; . ./.env; set +a`   (a dev server, and direnv)
#   * a service: the `EnvironmentVariables` dict in
#     scripts/pwa-pantry-recipes.example.plist — which is what
#     `scripts/install_launchagent.sh` renders, and the only thing that
#     configures the LaunchAgent. launchd does not run a shell, so `set -a`
#     has no effect there. The installer deliberately does NOT create a .env:
#     a second source of truth for these same values is how they drift.
#     Keep this file and that dict in step; `tests/deploy/` asserts the dict
#     covers every key app/config.py reads, and no key it does not.
#
# Deployment is NOT authorized: no plist is installed, nothing is in
# `launchctl list`, and no Serve route exists. The path is built and verified
# (scripts/install_launchagent.sh, scripts/converge_gate.py,
# docs/runbook/deployment.md); see AGENTS.md § *Deploy*.
#
# The exact values for the two Tailscale-related settings are authoritative:
#   - PUBLIC_ORIGIN        must equal the exact origin Tailscale Serve serves.
#   - TAILSCALE_OWNER_LOGIN must equal the exact normalized login in the
#                          Tailscale-User-Login header the proxy injects
#                          (lowercased as reported by `tailscale status --json`
#                          -> Self.LoginName).

# --- Core (required) ---------------------------------------------------
# Absolute path to the Obsidian vault. This app never reads the production
# vault unless an operator explicitly points it here after authorization.
OBSIDIAN_VAULT_PATH=/Users/syang/obsidian/syang

# Absolute directory for app state (locks, recovery snapshots, idempotency
# ledgers). Must be OUTSIDE the vault. Created by the installer.
APP_DATA_DIR=/Users/syang/.local/share/pwa-pantry-recipes

# Exact public origin the PWA is served from (scheme://host[:port], no path).
# HTTPS required for non-loopback origins; HTTP allowed only for exact
# localhost / loopback IP origins. Compared BYTE FOR BYTE against the Origin
# header on every mutation, so one extra slash answers every write
# 403 origin_not_allowed.
# Loopback app port 8007 (2026-09-27 port audit: 8000/8002/8003/8004/8005/8006
# are all allocated — wardrobe prod/dev, deals, obsidian-daily, obsidian-monthly,
# obsidian-editor). Tailscale Serve ingress would take 8452 (8443, 8445-8451
# allocated); NOT configured yet. Two ports, never one end-to-end: the app
# listens on 8007 and Tailscale proxies 8452 to it. Never :443.
#   ports live: https://home-macbook-air.tailcd6e49.ts.net:8452
PUBLIC_ORIGIN=http://127.0.0.1:8007
# Production origin once Tailscale Serve is configured (do not enable before):
# PUBLIC_ORIGIN=https://home-macbook-air.tailcd6e49.ts.net:8452

# Exact normalized owner login; every Tailscale-User-Login must match
# byte-for-byte.
TAILSCALE_OWNER_LOGIN=you@example.com

# --- Identity / bind invariants ----------------------------------------
# Development-mode identity (used when TRUST_TAILSCALE_HEADERS=false).
# Any client-supplied identity header is rejected.
DEV_IDENTITY=you@example.com

# Bind address. MUST be loopback (127.0.0.1 / ::1 / localhost) in every mode.
# The Tailscale Serve proxy, not the app, is the only network-facing surface.
BIND_HOST=127.0.0.1

# true => trust the Tailscale-User-Login header injected by the Tailscale proxy
# (production). false => development identity mode. A non-loopback BIND_HOST
# with this true is rejected at startup.
TRUST_TAILSCALE_HEADERS=false

# IANA timezone for "today" and for the daily-note path derived from it.
APP_TIMEZONE=America/New_York

# --- Domain roots (server-owned; requests cannot select these) ----------
# Absolute path to the wholefoods-to-pantry producer's SQLite catalog
# (table `items`: canonical_name, category, variants, first_seen, last_seen,
# order_count, area, last_price). The PWA opens it READ-ONLY and never writes
# it — it is a sibling project's asset, not the vault's. Must be OUTSIDE the
# vault. A missing file is a startup error, so a misconfigured path can never
# masquerade as an empty pantry.
PANTRY_ITEMS_DB=/Users/syang/projects/wholefoods-to-pantry/assets/pantry_items.db

# Vault-relative folder holding recipe notes (one note per recipe). Read to
# build the recipe index; individual recipe notes are read-only to this app.
RECIPES_ROOT=Hobbies/做饭/Recipes

# Vault-relative root holding daily notes, year-subfoldered
# ({DAILY_NOTES_ROOT}/{year}/{year}-{mm}-{dd}.md). Cooking logs are appended
# to the daily note; the PWA does not create missing daily notes.
DAILY_NOTES_ROOT=日记

# --- Pantry Stock state (server-owned) ----------------------------------
# Vault-relative path to the pantry note that holds Pantry Stock state
# (open / in_progress / done / cancelled, per Pantry Unit). The catalog above
# supplies identity, brand and price; this note supplies state — a Pantry Item
# in the catalog with no open line here is bought before, not held now.
# Read-only to this app.
PANTRY_NOTE_RELATIVE=Logistics/库存/Pantry.md

# Inclusive YYYY-YYYY range bounding the year a request may name; a date
# outside it is 422 date_outside_configured_scope. Leave blank to leave the
# daily notes' own layout as the only bound, or set a range such as 2024-2027.
DAILY_NOTES_YEAR_POLICY=

# --- Read-only mode ------------------------------------------------------
# true => every /api/* mutation is refused with 403 read_only, before any
# existence check. There is deliberately no write allowlist: a read-only
# deployment that could still log a cook or edit a shortlist would be a
# confusing half-mode, and since the PWA never creates a missing daily note,
# this flag is the only gate between a mutation and the vault.
OBSIDIAN_READ_ONLY=false

# --- Cache TTLs and read budgets (seconds / bytes) -----------------------
# The TTLs bound how stale a read projection can be. Catalog and recipes change
# only on a restock or a note edit; stock changes while you toggle tasks in
# Obsidian with the PWA open, so STOCK_CACHE_SECONDS is the maximum staleness a
# chip colour can have. Raising it trades chip freshness for fewer parses.
CATALOG_CACHE_SECONDS=300
STOCK_CACHE_SECONDS=30
RECIPE_CACHE_SECONDS=60

# Hard ceiling on the bytes read from a single note, so a runaway or hostile
# file is rejected before it is parsed rather than after.
MAX_RECIPE_BYTES=2000000
